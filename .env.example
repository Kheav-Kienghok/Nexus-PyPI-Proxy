# Public address clients use (https, no trailing slash)
NEXUS_URL=https://nexus.example.com
# Names/IPs Caddy serves, comma-separated; all must be in your certificate
SITE_ADDRESSES='nexus.example.com, 192.0.2.10'

# Pinned Nexus version, never "latest"
NEXUS_TAG=3.98.2
# Pinned Caddy version, never "latest"
CADDY_TAG=2.11.7

# Admin password, set by setup.sh and used by the scripts
NEW_ADMIN_PASSWORD='change-me'
# true = clients can download without login, false = login required
ANONYMOUS=true
# Nexus JVM heap size
NEXUS_HEAP=2g
# Nexus off-heap memory limit, keep at or above the heap
NEXUS_DIRECT_MEM=3g
# Docker volume that stores Nexus data
NEXUS_VOLUME=nexus-data

# Docker Hub username, optional, raises the pull limit
DOCKERHUB_USER=
# Docker Hub read-only access token, required if the username is set
DOCKERHUB_TOKEN=

# Container engine for the helper scripts: docker or podman
ENGINE=docker
# Compose command for the helper scripts: 'docker compose' or 'podman-compose'
COMPOSE='docker compose'

# Internal CA file, only if the server does not trust your certificate's CA
# CA_CERT=/path/to/internal-ca.crt
